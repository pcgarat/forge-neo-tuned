diff --git a/backend/attention.py b/backend/attention.py
index a9ec092c..436db3da 100644
--- a/backend/attention.py
+++ b/backend/attention.py
@@ -380,19 +380,26 @@ def attention_flash(q, k, v, heads, mask=None, attn_precision=None, skip_reshape
         if mask.ndim == 3:
             mask = mask.unsqueeze(1)
 
-    try:
-        causal = kwargs.get("causal", False)
-        assert mask is None or causal
-        out = flash_attn_wrapper(
-            q.transpose(1, 2),
-            k.transpose(1, 2),
-            v.transpose(1, 2),
-            dropout_p=0.0,
-            causal=causal,
-        ).transpose(1, 2)
-        _fallback = False
-    except Exception as e:
-        logger.error(f"Error running flash_attn: {e}")
+    # flash_attn's CUDA kernel only supports unmasked (optionally causal) attention. Callers that
+    # need a real attn_mask/bias (Qwen-Image joint-attention padding, Krea2 ref_boost logit bias)
+    # always land here with a tensor, so the assert inside try/except turned an expected routing
+    # decision into an ERROR log on every block of every step. Route straight to SDPA when masked
+    # and keep the try/except only for genuine flash execution failures.
+    causal = kwargs.get("causal", False)
+    if mask is None or causal:
+        try:
+            out = flash_attn_wrapper(
+                q.transpose(1, 2),
+                k.transpose(1, 2),
+                v.transpose(1, 2),
+                dropout_p=0.0,
+                causal=causal,
+            ).transpose(1, 2)
+            _fallback = False
+        except Exception as e:
+            logger.error(f"Error running flash_attn: {e}")
+            _fallback = True
+    else:
         _fallback = True
 
     if _fallback:
