# Rutas en el HOST. Misma estructura que RunPod bajo /workspace/forge-data.
# Si no defines estas variables, el compose usa los defaults de abajo.

# UID/GID del host con el que corre Forge dentro del contenedor (ver `id -u` / `id -g`).
# Imprescindible en local: si el contenedor va como root, output/ queda root:root.
PUID=1000
PGID=1000
# Opcional: GIDs de video/render del host (`getent group video render`)
VIDEO_GID=44
RENDER_GID=992

# Directorio base de datos (modelos, output, config.json, extensions/). Se monta en /data.
DATA_PATH=/workspace/forge-data

# Extensiones. Por defecto viven dentro del árbol de datos (un solo volumen lógico).
# Puedes apuntar a otra ruta si ya tienes extensiones fuera de forge-data.
EXTENSIONS_PATH=/workspace/forge-data/extensions

# Nombre de la subcarpeta de modelos dentro de DATA_PATH. Forge usa "models" (minúsculas) por defecto.
# Si en tu disco la carpeta se llama "Models" (mayúscula), pon: MODELS_SUBDIR=Models
MODELS_SUBDIR=models

# Carpeta de checkpoints dentro de Models. Forge espera "Stable-diffusion" por defecto.
# Si la tuya se llama "StableDiffusion" (sin guión), pon: CHECKPOINT_SUBDIR=StableDiffusion
CHECKPOINT_SUBDIR=Stable-diffusion

# Carpeta de text encoders (CLIP, etc.) dentro de Models. Forge espera "text_encoder" por defecto.
# Si la tuya se llama "TextEncoders", pon: TEXT_ENCODER_SUBDIR=TextEncoders
TEXT_ENCODER_SUBDIR=text_encoder

# Infinite Image Browsing: restringe a qué rutas del sistema puede asomarse la extensión.
# Sin control de acceso, IIB puede navegar cualquier ruta legible por el contenedor.
# ALLOWED_PATHS admite tanto secciones de la UI (txt2img, img2img, extra, save) como rutas.
IIB_ACCESS_CONTROL=enable
IIB_ACCESS_CONTROL_ALLOWED_PATHS=txt2img,img2img,extra,save,/data/output,/data/Images

# Silencia el aviso de GitPython cuando no encuentra el binario de git (la imagen sí lo trae,
# pero las extensiones lo consultan al arrancar y ensucian el log).
GIT_PYTHON_REFRESH=quiet

# Argumentos extra para el arranque de Forge (se añaden a COMMANDLINE_ARGS vía entrypoint).
# Usar comillas si el valor contiene espacios (obligatorio para make up / make klein9b).
# `make klein9b`, `make lowvram` y `make chatbot` pisan este valor al arrancar.
#
# Perfil 8 GB (RTX 4060, etc.) — también definido como ARGS_8GB en el Makefile.
# No añadir --fast-fp8: falla en Krea 2 y no aporta.
# cuda-stream solapa el trasiego de pesos con el cómputo (con lowvram el cuello es la
# transferencia RAM↔VRAM). Requiere memlock holgado para que el pinning aplique de verdad
# (ya está en docker-compose.yml). Medir con `make bench-offload`.
# EXTRA_ARGS="--cuda-malloc --lowvram --fp8_e4m3fn-unet --reserve-vram 2 --cuda-stream --pin-shared-memory --mmap-torch-files"
#
# Otros perfiles:
# EXTRA_ARGS="--cuda-malloc --normalvram --bf16-unet --pin-shared-memory --mmap-torch-files"
# EXTRA_ARGS="--cuda-malloc --highvram --bf16-unet --pin-shared-memory --mmap-torch-files"

# Opcionales: subdirectorios bajo DATA_PATH. No hace falta definirlos
# si usas la estructura por defecto; útiles si quieres rutas distintas en el host.
# MODELS_PATH=/workspace/forge-data/models
# OUTPUT_PATH=/workspace/forge-data/output
# CONFIG_PATH=/workspace/forge-data

# Ruta host del repo sd-forge-img2prompt (desarrollo). Se monta en /data/extensions/sd-forge-img2prompt.
# IMG2PROMPT_EXT_PATH=/home/pacogarat/projects/sd-forge-img2prompt
